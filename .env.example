# Copy to .env. .env is gitignored — never commit real keys.

# --- Mode --------------------------------------------------------------------
# Which mode to start in. Options: visual, verbal, retro
# Can be overridden with `python -m compass --mode <mode>`
MODE=visual

# --- Vision provider (Visual mode) ------------------------------------------
# Options: claude, gemini (stub), mock
VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=

# Directive for the visual mode VLM. Defaults to a shop/fab-aware prompt; uncomment to override.
#VISION_PROMPT="Describe what you see in 1–2 short phrases (under 18 words total). If the image contains drawings, dimensions, materials, fasteners, panels, fabrication marks, part numbers, or anything that looks shop- or build-relevant, surface those first. Otherwise just describe the scene plainly."

# --- Coach provider (Verbal + Retro modes) ----------------------------------
# Options: claude, mock
COACH_PROVIDER=claude
COACH_MODEL=claude-sonnet-4-6

# --- Glasses hardware -------------------------------------------------------
# Glasses driver: 'mock' (default), 'halo' (requires hardware + pip install brilliant-msg), 'frame' (stub).
# GLASSES=mock
CAMERA_INDEX=0

# --- Memory store -----------------------------------------------------------
# Path to the SQLite memory database. Relative or absolute.
MEMORY_DB=./compass-memory.sqlite

# --- Audio / STT (Phase 2 stubs) --------------------------------------------
# Rolling buffer length in minutes. 30 = "last half hour available for retro queries"
AUDIO_BUFFER_MINUTES=30

# Audio buffer for retro mode: 'mock' (default) or 'laptop' (requires .[audio] extra).
# AUDIO_BUFFER=mock

# STT provider for retro/verbal modes: 'mock' (default) or 'whisper' (requires .[audio] extra).
# STT_PROVIDER=mock

# Whisper model size when STT_PROVIDER=whisper. Default: small.en (244 MB, ~10-20s for 5-min audio).
# Alternative: base.en (75 MB, ~1-3s for 5-min audio, less accurate on domain vocabulary).
# WHISPER_MODEL=small.en

# Verbal mode: seconds of speech captured after the trigger. Default 8.
# VERBAL_CAPTURE_SECONDS=8
