# Copy this file to `.env` and fill in your values.
# .env is gitignored — never commit real keys.

# --- Vision provider ---------------------------------------------------------
# Which AI backend to use. Options: claude, gemini (stub), mock
VISION_PROVIDER=claude

# Anthropic API key — get one at https://console.anthropic.com/
# Required if VISION_PROVIDER=claude
ANTHROPIC_API_KEY=

# Claude model. Options as of May 2026:
#   claude-haiku-4-5-20251001   fastest + cheapest, supports vision
#   claude-sonnet-4-6           balanced (default)
#   claude-opus-4-7             most capable, slowest, most expensive
CLAUDE_MODEL=claude-sonnet-4-6

# Google Gemini API key (only needed if VISION_PROVIDER=gemini)
GEMINI_API_KEY=

# --- Glasses hardware -------------------------------------------------------
# Which glasses driver to use. Options: mock, frame (stubbed for Phase 1)
GLASSES=mock

# Which webcam index to open (mock only). 0 is usually the built-in camera.
# Try 1 or 2 if 0 gives a black frame.
CAMERA_INDEX=0

# --- Prompt -----------------------------------------------------------------
# The directive prompt sent to the VLM. Keep answers short for the HUD.
VISION_PROMPT="In 8 words or fewer, name the most prominent subject in this image. If it's a plant or animal, use the common name. No punctuation."
